    "source": [
     "# Graficar los resultados de DBCV\n",
     "plt.figure(figsize=(10, 6))\n",
     "plt.plot(list(min_samples_range), dbcv_scores, marker='o', linestyle='-', color='teal', markersize=8)\n",
     "plt.title('DBCV Score vs min_samples (DBSCAN)', fontsize=14, pad=15)\n",
     "plt.xlabel('min_samples', fontsize=12)\n",
     "plt.ylabel('DBCV Score', fontsize=12)\n",
     "plt.grid(True, linestyle='--', alpha=0.7)\n",
     "plt.tight_layout()\n",
     "plt.show()"
    ]
   },
   {
    "cell_type": "code",

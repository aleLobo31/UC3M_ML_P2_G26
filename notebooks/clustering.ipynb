    "metadata": {},
    "outputs": [],
    "source": [
     "# Entrenar DBSCAN con el mejor min_samples\n",
     "dbscan_final = DBSCAN(eps=eps, min_samples=best_min_samples)\n",
     "etiquetas_dbscan = dbscan_final.fit_predict(X_reduced)\n",
     "\n",
     "# Ver número de clusters encontrados\n",
     "n_clusters = len(set(etiquetas_dbscan)) - (1 if -1 in etiquetas_dbscan else 0)\n",
     "n_noise = list(etiquetas_dbscan).count(-1)\n",
     "\n",
     "print(f\"Número de clusters encontrados: {n_clusters}\")\n",
     "print(f\"Puntos clasificados como ruido: {n_noise}\")\n",
     "\n",
     "# Visualización\n",
     "plt.figure(figsize=(10, 7))\n",
     "\n",
     "# Crear una paleta de colores (incluyendo ruido)\n",
     "colors = etiquetas_dbscan.copy()\n",
     "colors[colors == -1] = n_clusters  # Asignar un color específico para el ruido\n",
     "\n",
     "plt.scatter(X_reduced[:, 0], X_reduced[:, 1], \n",
     "            c=colors, cmap='viridis', \n",
     "            alpha=0.7, edgecolors='k', s=60)\n",
     "\n",
     "plt.title(f'DBSCAN (eps={eps}, min_samples={best_min_samples})', fontsize=14, pad=15)\n",
     "plt.xlabel('PC1', fontsize=12)\n",
     "plt.ylabel('PC2', fontsize=12)\n",
     "plt.tight_layout()\n",
     "plt.show()"
    ]
